# Puerto de la API Express
PORT=4000

# PostgreSQL (recomendado para persistencia real)
DATABASE_URL=postgresql://tarara:tarara@localhost:5432/tarara_music
DB_DRIVER=postgres

# Origen permitido del frontend (se pueden separar varios con coma)
CLIENT_ORIGIN=http://localhost:5173

# Cambia este secreto en cualquier despliegue real
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Modo demo sin PostgreSQL: sustituye DB_DRIVER=postgres por DB_DRIVER=memory
# DB_DRIVER=memory
